# 浏览器访问的后端 API 基址(留空 = 同源，开发期走 Vite proxy，生产走 nginx)
# 分域示例:https://api.example.com；不要以 / 结尾
VITE_API_BASE=

# 管理端普通请求与 Playground 流式请求的客户端超时(毫秒)
VITE_API_TIMEOUT_MS=30000
# 应略大于后端 gateway.http.stream-max-duration-ms(默认 300000)
VITE_STREAM_TIMEOUT_MS=310000

# 仅 npm run dev 使用
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173
VITE_PROXY_TARGET=http://localhost:8080
VITE_PROXY_TIMEOUT_MS=330000
# 代理自签名 HTTPS 后端时可设 false
VITE_PROXY_SECURE=true
